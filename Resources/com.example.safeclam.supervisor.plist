<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.safeclam.supervisor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/com.example.safeclam/bin/safeclam-supervisor</string>
  </array>
  <key>MachServices</key>
  <dict>
    <key>com.example.safeclam.supervisor</key>
    <true/>
    <key>com.example.safeclam.supervisor.activity</key>
    <true/>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ExitTimeOut</key>
  <integer>30</integer>
</dict>
</plist>
